# Anthropic API Key (required for AI extraction and summaries)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Port (default: 5000)
PORT=5000

# Anthropic Model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated allowed origins for CORS (leave empty for * in local development)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Optional app secret key (leave empty in local development)
APP_SHARED_SECRET=
